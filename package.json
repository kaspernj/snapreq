{
  "name": "snapreq",
  "version": "0.0.4",
  "description": "Cross-platform HTTP and WebSocket client with one API across Node, web, Expo and React Native",
  "type": "module",
  "main": "./src/snap-req.js",
  "types": "./types/snap-req.d.ts",
  "exports": {
    ".": {
      "types": "./types/snap-req.d.ts",
      "default": "./src/snap-req.js"
    },
    "./*": {
      "types": "./types/*.d.ts",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/**",
    "types/**"
  ],
  "scripts": {
    "all-checks": "npm run typecheck && npm run lint && npm run test",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "eslint src spec",
    "prepublishOnly": "npm run build:types",
    "release:patch": "release-patch",
    "test": "node --test \"spec/**/*-spec.js\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "http",
    "fetch",
    "websocket",
    "client",
    "expo",
    "react-native",
    "cross-platform"
  ],
  "author": "kasper@diestoeckels.de",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "eslint-plugin-jsdoc": "^63.0.0",
    "globals": "^17.6.0",
    "release-patch": "^1.0.0",
    "typescript": "^6.0.3",
    "ws": "^8.21.0"
  }
}
