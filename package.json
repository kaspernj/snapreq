{
  "name": "snapreq",
  "version": "0.0.2",
  "description": "Cross-platform HTTP and WebSocket client with one API across Node, web, Expo and React Native",
  "type": "module",
  "main": "./src/snap-req.js",
  "exports": {
    ".": "./src/snap-req.js",
    "./websocket": "./src/websocket/websocket-client.js",
    "./errors": "./src/errors.js",
    "./headers": "./src/headers.js",
    "./response": "./src/response.js",
    "./retry": "./src/retry.js",
    "./capabilities": "./src/capabilities.js",
    "./transports/select": "./src/transports/select.js",
    "./transports/fetch": "./src/transports/fetch-transport.js",
    "./transports/xhr": "./src/transports/xhr-transport.js",
    "./*": "./src/*.js"
  },
  "files": [
    "src/**"
  ],
  "scripts": {
    "all-checks": "npm run typecheck && npm run lint && npm run test",
    "lint": "eslint src spec",
    "test": "node --test \"spec/**/*-spec.js\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "http",
    "fetch",
    "websocket",
    "client",
    "expo",
    "react-native",
    "cross-platform"
  ],
  "author": "kasper@diestoeckels.de",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^16.0.0",
    "typescript": "^6.0.3",
    "ws": "^8.21.0"
  }
}
