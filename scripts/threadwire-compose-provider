#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

fail() {
  printf 'threadwire-compose-provider: %s\n' "$*" >&2
  exit 2
}

[[ "${THREADWIRE_ACTIVE:-}" == "1" ]] \
  || fail "this adapter may only be invoked as a Threadwire provider child"
[[ $# -gt 0 ]] || fail "missing Codex arguments"

case "$1" in
  exec|resume)
    ;;
  *)
    fail "Threadwire Codex mode must begin with exec or resume"
    ;;
esac

for argument in "$@"; do
  case "$argument" in
    -C|-C?*|--cd|--cd=*|--add-dir|--add-dir=*|-s|-s?*|--sandbox|--sandbox=*|-a|-a?*|--ask-for-approval|--ask-for-approval=*|-c|-c?*|--config|--config=*|--dangerously-*|--remote|--remote=*|--remote-auth-token-env|--remote-auth-token-env=*)
      fail "Threadwire supplied a Codex argument that can change the container boundary"
      ;;
  esac
done

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
helper="$script_dir/hermes-compose"
[[ -x "$helper" ]] || fail "missing executable Hermes Compose lifecycle helper"

exec "$helper" provider-exec \
  codex \
  --dangerously-bypass-approvals-and-sandbox \
  -C /workspace \
  "$@"
